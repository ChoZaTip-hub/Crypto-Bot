# Application
APP_NAME=crypto-trading-bot
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Trading mode: paper (default) | live
TRADING_MODE=paper
# Live trading requires explicit enablement
LIVE_TRADING_ENABLED=false

# Bybit V5 spot (mainnet — та же цена, что на TradingView BYBIT:*)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_CATEGORY=spot

# Database (SQLite default — works without Docker)
DATABASE_URL=sqlite+aiosqlite:///./data/trading_bot.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trading_bot

# Redis
REDIS_URL=redis://localhost:6379/0

# Symbol universe: whitelist = bot trades only these | bybit_top = ~120 USDT pairs in UI
SYMBOL_LIST_SOURCE=bybit_top
SYMBOL_TOP_LIMIT=120
SYMBOL_WHITELIST=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
TIMEFRAMES=1,5,15,30,60,240,D,W,M

# Risk limits
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_OPEN_POSITIONS=3
MAX_EXPOSURE_PER_SYMBOL=0.15
MANDATORY_STOP_LOSS=true
KILL_SWITCH=false
CIRCUIT_BREAKER_DRAWDOWN=0.10
DATA_STALE_SECONDS=120
MAX_ATR_PCT=0.05
# SL/TP от ATR (таймфрейм графика): SL=1.5×ATR, TP=4.5×ATR → ~1:3. MIN ≥ 1:2.
SL_ATR_MULTIPLIER=1.5
TP_ATR_MULTIPLIER=4.5
MIN_RISK_REWARD_RATIO=2.0

# Paper trading
PAPER_INITIAL_BALANCE=10000.0
PAPER_SLIPPAGE_BPS=5.0
# Размер сделки: fixed_usdt (сумма в USDT) | risk_percent (% депозита по SL)
POSITION_SIZE_MODE=fixed_usdt
ORDER_USDT=100
# Market = вход сразу | Limit = лимит по цене entry из сигнала
ENTRY_ORDER_TYPE=Market

# API security (optional admin token)
API_ADMIN_TOKEN=

# Bot orchestrator
BOT_AUTO_START=false
MARKET_POLL_INTERVAL_SECONDS=5
USE_BYBIT_MARKET_DATA=true

# 24/7 background: SL/TP position monitor (runs even when bot is stopped)
BACKGROUND_SERVICES_ENABLED=true
POSITION_MONITOR_INTERVAL_SECONDS=10

# Memory & adaptive learning (chart + indicators)
MEMORY_ENABLED=true
LEARNING_ENABLED=true

# AI analyst (OpenAI-compatible: OpenAI, OpenRouter, LM Studio…)
# Данные: свечи + индикаторы Bybit (как у бота), не скрин TradingView
AI_ENABLED=false
AI_API_KEY=
# или OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1
AI_AUTO_ANALYZE=true
AI_INFLUENCE_TRADES=false
# Опционально: PNG свечей → vision-модель (pip install matplotlib)
AI_USE_CHART_IMAGE=false
AI_VISION_MODEL=gpt-4o-mini
AI_MIN_CONFIDENCE_INFLUENCE=0.62
AI_TIMEOUT_SECONDS=45

# Live SL/TP: attach stopLoss/takeProfit on Bybit at entry; monitor sends market close as backup
LIVE_PLACE_EXCHANGE_SL_TP=true
LIVE_CLOSE_SL_TP_ON_EXCHANGE=true

# Cross-asset ratios (BTC/ETH etc.) — proposals need your approval in dashboard
RATIO_SWAP_ENABLED=true
RATIO_MONITOR_INTERVAL_SECONDS=300
RATIO_HIGH_PERCENTILE=0.85
RATIO_LOW_PERCENTILE=0.15
RATIO_MIN_SNAPSHOTS=20
RATIO_SWAP_FRACTION=1.0
RATIO_PROPOSAL_TTL_HOURS=24

# Autonomous coin scanner (bot picks symbols from Bybit, not only whitelist)
SCANNER_ENABLED=true
SCANNER_UNIVERSE_SIZE=80
SCANNER_BATCH_SIZE=24
SCANNER_TOP_N=12
SCANNER_MIN_SCORE=1.2
SCANNER_MIN_TURNOVER_USDT=500000
SCANNER_TIMEFRAMES=5,15,60
MAX_SYMBOLS_PER_CYCLE=15

# Multi-account copy trading (add accounts via POST /api/v1/accounts)
MULTI_ACCOUNT_COPY_ENABLED=true
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# 24/7 on server
BOT_AUTO_START=true
MARKET_POLL_INTERVAL_SECONDS=30
