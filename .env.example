# Application
APP_NAME=crypto-trading-bot
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Trading mode: paper (default) | live
TRADING_MODE=paper
# Live trading requires explicit enablement
LIVE_TRADING_ENABLED=false

# Bybit V5 (spot)
BYBIT_TESTNET=true
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_CATEGORY=spot

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trading_bot

# Redis
REDIS_URL=redis://localhost:6379/0

# Symbol universe (comma-separated)
SYMBOL_WHITELIST=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
TIMEFRAMES=1,5,60

# Risk limits
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_OPEN_POSITIONS=3
MAX_EXPOSURE_PER_SYMBOL=0.15
MANDATORY_STOP_LOSS=true
KILL_SWITCH=false
CIRCUIT_BREAKER_DRAWDOWN=0.10
DATA_STALE_SECONDS=120
MAX_ATR_PCT=0.05

# Paper trading
PAPER_INITIAL_BALANCE=10000.0
PAPER_SLIPPAGE_BPS=5.0

# News — RSS feeds (comma-separated; defaults include CoinDesk, Cointelegraph, CryptoSlate, Decrypt, etc.)
# NEWS_RSS_URLS=https://thedefiant.io/feed/,https://www.coindesk.com/arc/outboundfeeds/rss/?outputType=xml,...

# Bybit Announcements (public API, no key) — https://bybit-exchange.github.io/docs/v5/announcement
BYBIT_ANNOUNCEMENTS_ENABLED=true
BYBIT_ANNOUNCEMENTS_LOCALE=en-US
BYBIT_ANNOUNCEMENTS_LIMIT=20

# Crypto News API aggregator (optional) — https://cryptonews-api.com
CRYPTO_NEWS_API_KEY=
CRYPTO_NEWS_API_BASE_URL=https://cryptonews-api.com/api/v1
CRYPTO_NEWS_API_ITEMS_PER_TICKER=10

NEWS_RSS_ENTRIES_PER_FEED=20

# API security (optional admin token)
API_ADMIN_TOKEN=

# Bot orchestrator
BOT_AUTO_START=false
MARKET_POLL_INTERVAL_SECONDS=5
USE_BYBIT_MARKET_DATA=true
